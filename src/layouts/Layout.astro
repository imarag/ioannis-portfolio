---
import "../styles/global.css"
import { Font } from "astro:assets"
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"
const { title, description, isHome = false } = Astro.props
const fullTitle = `${title} | Ioannis Maragkakis`
---

<!doctype html>
<html lang="en" data-theme={isHome ? "dark" : "winter"}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-inter" preload />
        <Font cssVariable="--font-instrument-serif" preload />
        <title>{fullTitle}</title>
        {description && <meta name="description" content={description} />}
    </head>
    <body
        class={`flex flex-col items-stretch min-h-screen ${isHome ? "bg-portfolio" : "bg-base-100 bg-page"} text-base-content font-sans`}
    >
        <div class={`${isHome ? "absolute  left-0 right-0" : "relative"}`}>
            <Header isHome={isHome} />
        </div>
        <main class="grow container mx-auto space-y-4 px-4 tablet:px-8">
            <slot />
        </main>
        <Footer />
    </body>
</html>
