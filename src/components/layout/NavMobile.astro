---
import { Icon } from "astro-icon/components"
import { links } from "../../data"
const pathname = Astro.url.pathname
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "")
const { isHome } = Astro.props
---

<nav
    id="mobile-menu"
    class={`sm:hidden absolute left-0 right-0 top-full ${isHome ? "bg-black" : "bg-base-200"} shadow-lg overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out`}
>
    <ul class="flex flex-col px-6 py-4">
        {
            links.map((link, index) => {
                const isActive = currentPath === link.href
                return (
                    <li class="border-b border-base-300">
                        <a
                            href={link.href}
                            class={`flex items-center justify-between py-4 px-2 transition-colors hover:text-primary ${
                                isActive
                                    ? "text-primary font-semibold"
                                    : "text-base-content"
                            }`}
                            aria-current={isActive ? "page" : undefined}
                        >
                            <span>{link.label}</span>
                            <Icon
                                name="material-symbols:chevron-right-rounded"
                                class="size-4 opacity-40"
                            />
                        </a>
                    </li>
                )
            })
        }
    </ul>
</nav>
