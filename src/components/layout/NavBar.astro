---
import Logo from "./Logo.astro"
import { socials, links } from "../../data"
import { Icon } from "astro-icon/components"

const pathname = Astro.url.pathname
const { isHome } = Astro.props
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "")
---

<header
    class="sticky top-0 z-40 bg-transparent backdrop-blur border-b border-base-200"
>
    <div
        class="container mx-auto text-sm text-base-content px-8 py-4 flex flex-row items-center gap-8"
    >
        <Logo />

        <nav class="ms-8 gap-4 hidden sm:flex">
            {
                links.map((link) => {
                    const isActive = currentPath === link.href
                    return (
                        <a
                            href={link.href}
                            class={`link link-hover transition-colors ${isActive && "text-primary font-semibold no-underline"}`}
                            aria-current={isActive ? "page" : undefined}
                        >
                            {link.label}
                        </a>
                    )
                })
            }
        </nav>

        <div class="flex justify-center gap-4 ms-auto">
            {
                socials.map((social) => (
                    <a href={social.href} aria-label={social.label}>
                        <Icon
                            name={social.icon}
                            class="size-6 hover:text-primary transition"
                        />
                    </a>
                ))
            }
        </div>

        <button
            id="menu-toggle"
            class="btn btn-ghost sm:hidden"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <Icon
                id="menu-icon-open"
                name="material-symbols:menu-rounded"
                class="size-6"
            />
            <Icon
                id="menu-icon-close"
                name="material-symbols:close-rounded"
                class="size-6 hidden"
            />
        </button>
    </div>

    <nav
        id="mobile-menu"
        class={`sm:hidden absolute left-0 right-0 top-full ${isHome ? "bg-base-200/20" : "bg-base-200"} shadow-lg overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out`}
    >
        <ul class="flex flex-col px-6 py-4">
            {
                links.map((link, index) => {
                    const isActive = currentPath === link.href
                    return (
                        <li
                            class={
                                index !== 0 ? "border-t border-base-300" : ""
                            }
                        >
                            <a
                                href={link.href}
                                class={`flex items-center justify-between py-4 px-2 transition-colors hover:text-primary ${
                                    isActive
                                        ? "text-primary font-semibold"
                                        : "text-base-content"
                                }`}
                                aria-current={isActive ? "page" : undefined}
                            >
                                <span>{link.label}</span>
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="size-4 opacity-40"
                                />
                            </a>
                        </li>
                    )
                })
            }
        </ul>
    </nav>
</header>

<script>
    const toggle = document.getElementById("menu-toggle")
    const menu = document.getElementById("mobile-menu")
    const iconOpen = document.getElementById("menu-icon-open")
    const iconClose = document.getElementById("menu-icon-close")

    toggle?.addEventListener("click", () => {
        const isOpen = menu?.classList.contains("max-h-96")

        if (isOpen) {
            menu?.classList.remove("max-h-96")
            menu?.classList.add("max-h-0")
            iconOpen?.classList.remove("hidden")
            iconClose?.classList.add("hidden")
            toggle.setAttribute("aria-expanded", "false")
        } else {
            menu?.classList.remove("max-h-0")
            menu?.classList.add("max-h-96")
            iconOpen?.classList.add("hidden")
            iconClose?.classList.remove("hidden")
            toggle.setAttribute("aria-expanded", "true")
        }
    })
</script>
