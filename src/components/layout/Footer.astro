---
import Socials from "../ui/Socials.astro"
const currentYear = new Date().getFullYear()
---

<footer class="bg-transparent text-center mt-12 py-8">
    <div class="container mx-auto px-8 flex flex-col items-center gap-4">
        <p class="text-2xl font-display">Ioannis Maragkakis</p>
        <Socials size="small" variant="full" />
        <p class="text-sm text-base-content/60">
            &copy; {currentYear} Ioannis Maragkakis. All rights reserved.
        </p>
    </div>
</footer>
