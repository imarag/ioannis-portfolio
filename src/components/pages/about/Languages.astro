---
import { languages } from "../../../data"
---

<div>
    <h2 class="text-2xl font-bold mb-6">Languages</h2>
    <div class="flex flex-wrap gap-2">
        {
            languages.map((lang) => (
                <span class="badge badge-accent badge-soft badge-lg">
                    {lang}
                </span>
            ))
        }
    </div>
</div>
