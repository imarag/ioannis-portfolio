---
import Section from "../../ui/Section.astro"
---

<Section title="Some Things About Me" centerTitle={true}>
    <div
        class="flex flex-row justify-center font-normal items-center gap-4 text-2xl"
    >
        <span>A fullstack developer</span>
        <span>·</span>
        <span>Seismology enthusiast</span>
        <span>·</span>
        <span>An active learner</span>
    </div>
    <p class="text-lg text-center mx-auto max-w-3xl text-base-content/60">
        I'm a full stack developer with a passion for building web applications.
        I have experience working with a variety of technologies and enjoy
        learning new ones. In my free time, I like to work on personal projects
        and contribute to open source.
    </p>
    <div class="text-center">
        <button class="btn btn-primary btn-outline">learn more</button>
    </div>
</Section>
