---
import Section from "../../ui/Section.astro"
import SectionTitle from "../../ui/SectionTitle.astro"
import Socials from "../../ui/Socials.astro"
import { socials } from "../../../data"
import { Icon } from "astro-icon/components"
---

<Section>
    <div class="card border border-base-300">
        <div
            class="card-body flex flex-col items-stretch text-center gap-6 py-12"
        >
            <SectionTitle>Let's Work Together</SectionTitle>

            <p class="max-w-2xl mx-auto text-base-content/70 leading-relaxed">
                I'm always open to new opportunities and collaborations. Whether
                you have a project in mind or just want to connect, I'd love to
                hear from you.
            </p>

            <div>
                <a
                    href={socials.email.href}
                    class="btn btn-primary btn-lg gap-2"
                >
                    <Icon name={socials.email.icon} class="size-5" />
                    Get in touch
                </a>
            </div>
            <div>
                <div class="divider max-w-sm w-full mx-auto">or find me on</div>
            </div>
            <Socials variant="outline" removeSocials={["email"]} />
        </div>
    </div>
</Section>
