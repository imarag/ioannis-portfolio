---
import { Icon } from "astro-icon/components"

const { project } = Astro.props

const allTechs = Object.values(project.technologies).flat()
---

<div
    class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col"
>
    {/* Image */}
    {
        project.image && (
            <figure class="aspect-video bg-base-300 overflow-hidden">
                <img
                    src={project.image.src}
                    alt={project.alt}
                    class="w-full h-full object-cover"
                />
            </figure>
        )
    }

    <div class="card-body flex flex-col grow">
        {/* Title + status */}
        <div class="flex items-start justify-between gap-2">
            <h3 class="card-title text-lg">{project.title}</h3>
            {
                project.status && (
                    <span class="badge badge-success badge-soft badge-sm shrink-0">
                        {project.status}
                    </span>
                )
            }
        </div>

        {/* Subtitle */}
        <p class="text-base-content/70 text-sm">{project.subtitle}</p>

        {/* Tech badges (limited to 4 so the card stays compact) */}
        <div class="flex flex-wrap gap-1.5 mt-2">
            {
                allTechs
                    .slice(0, 4)
                    .map((tech) => (
                        <span class="badge badge-primary badge-soft badge-sm">
                            {tech}
                        </span>
                    ))
            }
            {
                allTechs.length > 4 && (
                    <span class="badge badge-ghost badge-sm">
                        +{allTechs.length - 4}
                    </span>
                )
            }
        </div>

        {/* Links - pushed to bottom */}
        <div class="card-actions mt-auto pt-4">
            {
                project.links.live && (
                    <a
                        href={project.links.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary btn-sm"
                    >
                        <Icon name="mdi:open-in-new" class="size-4" />
                        Live
                    </a>
                )
            }
            {
                project.links.github && (
                    <a
                        href={project.links.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-outline btn-sm"
                    >
                        <Icon name="mdi:github" class="size-4" />
                        Code
                    </a>
                )
            }
        </div>
    </div>
</div>
