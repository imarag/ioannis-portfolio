---
import HeroImage from "../../../assets/hero-image.png"
import { Icon } from "astro-icon/components"
---

<section class="min-h-[calc(100vh-6rem)] flex items-center">
    <div
        class="container mx-auto px-4 laptop:px-8 flex flex-col tablet:flex-row items-center"
    >
        <div class="flex-1 flex flex-col gap-4 text-center laptop:text-left">
            <p class="text-lg text-base-content/80">Hi, I'm</p>
            <h1
                class="font-display font-semibold text-4xl laptop:text-5xl tracking-tight leading-tight"
            >
                <span class="text-primary">Ioannis Maragkakis</span>
            </h1>

            <p class="text-lg text-base-content/90">
                Full-stack developer building web apps with React, Node.js, and
                Python. Background in data science and geophysics.
            </p>
            <p
                class="text-sm text-base-content/60 flex items-center gap-2 justify-center laptop:justify-start"
            >
                <Icon name="mdi:map-marker" class="size-4" />
                Thessaloniki, Greece · Open to remote work
            </p>

            <div
                class="flex flex-wrap items-center gap-4 mt-6 justify-center laptop:justify-start"
            >
                <a
                    href="/Ioannis_Maragkakis_Resume.pdf"
                    download="Ioannis_Maragkakis_Resume.pdf"
                    class="btn btn-primary"
                >
                    <Icon name="mdi:download" class="size-4" />
                    Download CV
                </a>
                <a href="/projects" class="btn btn-primary btn-outline">
                    View Projects
                    <Icon name="mdi:arrow-right" class="size-4" />
                </a>
            </div>
        </div>
        <div class="flex-1 justify-center items-center hidden laptop:flex">
            <img
                src={HeroImage.src}
                alt="Portrait of Ioannis Maragkakis"
                class="w-full h-auto max-h-128 object-contain"
            />
        </div>
    </div>
</section>
