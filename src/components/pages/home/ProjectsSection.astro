---
import Section from "../../ui/Section.astro"
import { projectsDetailed } from "../../../data"
import ProjectCard from "../home/ProjectCard.astro"
import { Icon } from "astro-icon/components"
---

<Section centerTitle={true} title="Projects I've worked on">
    <p class="text-center text-base-content/70 max-w-2xl mx-auto mb-12 -mt-4">
        A selection of full-stack apps and tools I've built — from earthquake
        monitoring platforms to interactive map-based applications.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projectsDetailed.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="flex justify-center mt-10">
        <a href="/projects" class="btn btn-primary btn-outline">
            See all projects
            <Icon name="mdi:arrow-right" class="size-4" />
        </a>
    </div>
</Section>
